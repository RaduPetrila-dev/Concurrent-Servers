{
  "uid": "concurrent-servers",
  "title": "Concurrent Servers",
  "tags": [
    "concurrent-servers"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "Server model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(server_connections_accepted_total, model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Connections offered against served",
      "description": "Refused against accepted. A flat latency line next to a rising refusal rate means the server is winning by turning work away.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (model) (rate(server_connections_accepted_total{model=~\"$model\"}[15s]))",
          "legendFormat": "{{model}} accepted"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (model) (rate(server_connections_refused_total{model=~\"$model\"}[15s]))",
          "legendFormat": "{{model}} refused"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request service time percentiles",
      "description": "Derived from histogram buckets, so resolution is limited by the bucket boundaries in metrics.c.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le, model) (rate(server_request_duration_seconds_bucket{model=~\"$model\"}[30s])))",
          "legendFormat": "{{model}} p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.90, sum by (le, model) (rate(server_request_duration_seconds_bucket{model=~\"$model\"}[30s])))",
          "legendFormat": "{{model}} p90"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, model) (rate(server_request_duration_seconds_bucket{model=~\"$model\"}[30s])))",
          "legendFormat": "{{model}} p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Thread pool queue depth and workers busy",
      "description": "Queue depth pinned at 64 is the ceiling, not healthy saturation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 64
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "server_pool_queue_depth{model=~\"$model\"}",
          "legendFormat": "{{model}} queue depth"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "server_pool_workers_busy{model=~\"$model\"}",
          "legendFormat": "{{model}} workers busy"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "server_connections_active{model=~\"$model\"}",
          "legendFormat": "{{model}} active connections"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Refusal rate",
      "description": "Refused as a share of offered. Gaps mean no connection attempts in the window.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum by (model) (rate(server_connections_refused_total{model=~\"$model\"}[15s])) / (sum by (model) (rate(server_connections_accepted_total{model=~\"$model\"}[15s])) + sum by (model) (rate(server_connections_refused_total{model=~\"$model\"}[15s])))",
          "legendFormat": "{{model}} refused"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Kernel drops before accept()",
      "description": "ListenOverflows means the accept queue was full. TCPSynRetrans means a peer retransmitted a SYN. Neither is visible to the server process, which is why the server-side refusal counter undercounts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_netstat_TcpExt_ListenOverflows[15s])",
          "legendFormat": "accept queue overflow"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_netstat_TcpExt_ListenDrops[15s])",
          "legendFormat": "listen drops"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_netstat_TcpExt_TCPSynRetrans[15s])",
          "legendFormat": "SYN retransmits"
        }
      ]
    }
  ]
}
